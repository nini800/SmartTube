<?xml version="1.0" encoding="utf-8"?>
<!-- Row sections (Home, Trending...): YouTube's rows as tabs on top, the selected row as a 2D grid below -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:lb="http://schemas.android.com/apk/res-auto"
             android:id="@+id/browse_dummy"
             android:layout_width="match_parent"
             android:layout_height="match_parent" >

    <androidx.leanback.widget.BrowseFrameLayout
            android:id="@+id/grid_frame"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:descendantFocusability="afterDescendants"
            android:clipChildren="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent" >

        <!-- Taller than the screen by the tabs area: hiding the tabs slides it up, so the grid gets that space -->
        <LinearLayout
                android:id="@+id/tabs_content"
                android:orientation="vertical"
                android:clipChildren="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent" >

            <androidx.leanback.widget.HorizontalGridView
                    android:id="@+id/tabs_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/tabs_row_height"
                    android:layout_marginTop="@dimen/tabs_row_margin_top"
                    android:paddingStart="?attr/browsePaddingStart"
                    android:paddingEnd="?attr/browsePaddingStart"
                    android:clipToPadding="false"
                    lb:focusOutFront="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true" />

            <FrameLayout
                    android:id="@+id/browse_grid_dock"
                    android:clipChildren="true"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

        </LinearLayout>

    </androidx.leanback.widget.BrowseFrameLayout>
</FrameLayout>
