<?xml version="1.0" encoding="utf-8"?>
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_vertical"
          android:paddingStart="@dimen/tab_item_padding_horizontal"
          android:paddingEnd="@dimen/tab_item_padding_horizontal"
          android:paddingTop="@dimen/tab_item_padding_vertical"
          android:paddingBottom="@dimen/tab_item_padding_vertical"
          android:maxWidth="@dimen/tab_item_max_width"
          android:singleLine="true"
          android:ellipsize="end"
          android:textSize="@dimen/tab_item_text_size"
          android:textColor="@color/tab_item_text"
          android:background="@drawable/tab_item_background"
          android:focusable="true"
          android:focusableInTouchMode="true" />
